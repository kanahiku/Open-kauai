---
/**
 * Horizontal shelf of listing cards with a section header.
 * Cards scroll horizontally on small screens. The arrow buttons are decorative
 * until the carousel controls ship.
 */
import ListingCard from '~/components/home/ListingCard.astro';
import { assetUrl } from '~/utils/assets';
import type { ShelfData } from '~/lib/home';
import type { ListingLabels } from '~/lib/site';

interface Props {
  shelf: ShelfData;
  seeAllLabel?: string;
  first?: boolean;
  labels?: ListingLabels;
}

const { shelf, seeAllLabel, first = false, labels } = Astro.props;
---

<section
  class:list={['px-5 pb-10 lg:px-[120px]', first ? 'pt-16 lg:pt-[92px]' : 'pt-10']}
  aria-labelledby={`shelf-${shelf.id}`}
>
  <div class="mx-auto flex max-w-[1200px] flex-col gap-6">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-3.5">
        <span class="flex shrink-0 rounded-pill bg-teal-wash p-3">
          <img src={assetUrl(shelf.icon)} alt="" class="size-[22px]" />
        </span>
        <div class="flex flex-col gap-0.5">
          {
            shelf.eyebrow && (
              <p class="font-display text-[13px] leading-4 tracking-[1.6px] text-teal uppercase">{shelf.eyebrow}</p>
            )
          }
          <h2 id={`shelf-${shelf.id}`} class="font-display text-2xl leading-[30px] text-teal-deep">{shelf.title}</h2>
        </div>
      </div>
      <div class="flex items-center gap-2.5">
        {
          seeAllLabel && (
            <a href={shelf.seeAllHref} class="font-sans text-sm leading-5 font-semibold text-teal hover:underline">
              {seeAllLabel}
            </a>
          )
        }
        <span aria-hidden="true" class="flex rounded-pill border border-line bg-white p-2.5">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="text-ink"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg
          >
        </span>
        <span aria-hidden="true" class="flex rounded-pill border border-line bg-white p-2.5">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="text-ink"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
          >
        </span>
      </div>
    </div>

    <ul class="-mx-5 flex snap-x snap-mandatory gap-6 overflow-x-auto px-5 pb-2 lg:mx-0 lg:px-0">
      {
        shelf.items.map((item) => (
          <li class="snap-start">
            <ListingCard item={item} labels={labels} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
