---
import type { SiteSettings } from '~/lib/site';
import { siteOrigin } from '~/config/site';

interface Props {
  settings: SiteSettings;
  /**
   * Custom JSON-LD schema override from Sanity.
   * When provided, replaces the auto-generated schema for the page.
   */
  schemaOverride?: string | Record<string, unknown>;
}

const { settings, schemaOverride } = Astro.props;

function parseSchemaOverride(override?: string | Record<string, unknown>): Record<string, unknown> | null {
  if (!override) return null;
  if (typeof override === 'object') return override;
  try {
    return JSON.parse(override);
  } catch {
    console.warn('Invalid JSON-LD schemaOverride:', override);
    return null;
  }
}

const origin = siteOrigin();
const organizationId = `${origin}/#organization`;

const generated: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${origin}/#website`,
    url: `${origin}/`,
    name: settings.siteName,
    description: settings.description,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: settings.siteName,
    url: `${origin}/`,
    description: settings.description,
    ...(settings.phone ? { telephone: settings.phone } : {}),
    ...(settings.email ? { email: settings.email } : {}),
    ...(settings.areaServed ? { areaServed: { '@type': 'AdministrativeArea', name: settings.areaServed } } : {}),
    ...(settings.socialLinks?.length ? { sameAs: settings.socialLinks } : {}),
  },
];

const custom = parseSchemaOverride(schemaOverride);
const blocks = custom ? [custom] : generated;
---

{blocks.map((block) => <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />)}
