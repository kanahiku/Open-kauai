---
/**
 * "Claim your business" form. Every label and message comes from Sanity. The script in
 * `scripts/claim-form.ts` sends it to /api/claims and swaps in the thank-you message.
 * `website` is a honeypot: people never see it, bots fill it in.
 */
import SelectField from '~/components/common/SelectField.astro';
import type { ForBusinessesContent } from '~/lib/info-pages';

interface Props {
  form: ForBusinessesContent['form'];
}

const { form } = Astro.props;

const label = 'font-display text-[13px] leading-4 tracking-[1.6px] text-teal uppercase';
const control =
  'w-full rounded-xl border border-line bg-white px-4 py-3 font-serif text-[17px] leading-6 text-ink placeholder:text-muted/70 focus:border-teal focus:outline-2 focus:outline-offset-2 focus:outline-sky';
---

<div
  data-claim
  data-error={form.errorMessage ?? ''}
  data-invalid={form.invalidMessage ?? ''}
  data-sending={form.sendingLabel ?? ''}
  class="flex flex-col gap-6 rounded-card border border-line bg-white p-6 shadow-card lg:p-8"
>
  {form.formTitle && <h2 class="font-display text-[28px] leading-10 text-teal-deep">{form.formTitle}</h2>}

  <form data-claim-form novalidate class="flex flex-col gap-5">
    <label class="flex flex-col gap-2">
      <span class={label}>{form.businessNameLabel}</span>
      <input
        name="businessName"
        type="text"
        required
        maxlength="120"
        autocomplete="organization"
        value={form.prefill.name}
        class={control}
      />
    </label>

    <div class="grid gap-5 sm:grid-cols-2">
      <label class="flex flex-col gap-2">
        <span class={label}>{form.townLabel}</span>
        <SelectField name="town" required class={control}>
          <option value="" disabled selected={!form.prefill.town}>{form.townPlaceholder ?? ''}</option>
          {
            form.towns.map((town) => (
              <option value={town} selected={town === form.prefill.town}>
                {town}
              </option>
            ))
          }
        </SelectField>
      </label>
      <label class="flex flex-col gap-2">
        <span class={label}>{form.roleLabel}</span>
        {
          form.roles.length > 0 ? (
            <SelectField name="role" required class={control}>
              {form.roles.map((role) => (
                <option value={role}>{role}</option>
              ))}
            </SelectField>
          ) : (
            <input name="role" type="text" required maxlength="60" class={control} />
          )
        }
      </label>
    </div>

    <label class="flex flex-col gap-2">
      <span class={label}>{form.emailLabel}</span>
      <input name="email" type="email" required maxlength="120" autocomplete="email" class={control} />
    </label>

    <label class="flex flex-col gap-2">
      <span class={label}>{form.ownershipLabel}</span>
      <textarea name="ownershipNote" rows="3" maxlength="1000" placeholder={form.ownershipPlaceholder} class={control}
      ></textarea>
    </label>

    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label>
        Website
        <input name="website" type="text" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    {
      form.confirmText && (
        <label class="flex items-start gap-3">
          <input
            name="confirmed"
            type="checkbox"
            required
            class="mt-1 size-[18px] shrink-0 rounded-[4px] border border-line accent-teal"
          />
          <span class="font-serif text-[15px] leading-[22px] text-ink">{form.confirmText}</span>
        </label>
      )
    }

    <p data-claim-message role="alert" class="hidden font-sans text-sm leading-5 text-[#9b2c2c]"></p>

    <button
      type="submit"
      data-claim-submit
      class="w-fit rounded-pill bg-teal px-6 py-3.5 font-sans text-sm leading-5 font-semibold text-white hover:bg-teal-deep disabled:cursor-wait disabled:opacity-70"
    >
      {form.submitLabel}
    </button>
  </form>

  <div data-claim-done hidden class="flex flex-col gap-2" role="status">
    {form.successTitle && <h3 class="font-display text-[24px] leading-[30px] text-teal-deep">{form.successTitle}</h3>}
    {form.successBody && <p class="font-serif text-[17px] leading-[26px] text-ink">{form.successBody}</p>}
  </div>
</div>

<script>
  import '~/scripts/claim-form';
</script>
