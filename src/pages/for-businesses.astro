---
/**
 * /for-businesses/. Intro and the claim form, copy from the `forBusinessesPage` document.
 * `?business=<slug>` prefills the business name and town. Submissions go to /api/claims/.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/common/PageHero.astro';
import Image from '~/components/common/Image.astro';
import ClaimForm from '~/components/pages/ClaimForm.astro';
import { loadForBusinessesPage } from '~/lib/info-pages';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const page = await loadForBusinessesPage(Astro.url.searchParams.get('business'));
---

<PageLayout metadata={{ title: page.seo.title, description: page.seo.description }}>
  <PageHero eyebrow={page.eyebrow} title={page.title} lede={page.lede}>
    {
      page.heroImages.length > 0 && (
        <div slot="aside" class="relative hidden h-[220px] w-[440px] lg:block">
          {page.heroImages.map((src, index) => (
            <Image
              src={src}
              alt=""
              layout="none"
              class:list={[
                'absolute rounded-card border-4 border-white object-cover shadow-popover',
                index === 0
                  ? 'top-0 left-0 h-[170px] w-[250px] -rotate-3'
                  : 'right-0 bottom-0 h-[150px] w-[220px] rotate-2',
              ]}
            />
          ))}
          {page.heroCaption && (
            <span class="absolute bottom-3 left-6 rounded-pill bg-white px-3.5 py-1.5 font-serif text-[15px] text-teal-deep italic">
              {page.heroCaption}
            </span>
          )}
        </div>
      )
    }
  </PageHero>

  <section class="site-frame grid items-start gap-6 py-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:py-[72px]">
    <ClaimForm form={page.form} />

    {
      page.nextSteps.length > 0 && (
        <aside class="flex flex-col gap-5 rounded-card bg-tint p-6 lg:p-8" aria-labelledby="next-title">
          {page.nextTitle && (
            <h2 id="next-title" class="font-display text-[24px] leading-[30px] text-teal-deep">
              {page.nextTitle}
            </h2>
          )}
          <ol class="flex flex-col gap-3.5">
            {page.nextSteps.map((step, index) => (
              <li class="flex items-start gap-3">
                <span class="flex size-6 shrink-0 items-center justify-center rounded-pill bg-teal font-sans text-xs leading-4 font-semibold text-white">
                  {index + 1}
                </span>
                <span class="font-serif text-[17px] leading-[26px] text-ink">{step}</span>
              </li>
            ))}
          </ol>
        </aside>
      )
    }
  </section>
</PageLayout>
