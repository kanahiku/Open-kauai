---
import PageLayout from '~/layouts/PageLayout.astro';
import { getSiteSettings } from '~/lib/site';

const settings = await getSiteSettings();
---

<PageLayout metadata={{ title: settings.notFoundTitle ?? '404', robots: { index: false, follow: true } }}>
  <section class="site-frame flex min-h-[60vh] flex-col items-start justify-center gap-6 py-24">
    <p class="font-display text-[13px] leading-4 tracking-[1.6px] text-teal uppercase">404</p>
    {
      settings.notFoundTitle && (
        <h1 class="font-display text-[48px] leading-[56px] tracking-[-0.5px] text-teal-deep">
          {settings.notFoundTitle}
        </h1>
      )
    }
    {
      settings.notFoundBody && (
        <p class="max-w-[560px] font-serif text-xl leading-[30px] text-ink">{settings.notFoundBody}</p>
      )
    }
    <a
      href="/"
      class="inline-flex items-center rounded-pill bg-teal px-6 py-3.5 font-sans text-sm font-semibold text-white hover:bg-teal-deep"
    >
      {settings.notFoundLinkLabel ?? settings.siteName}
    </a>
  </section>
</PageLayout>
