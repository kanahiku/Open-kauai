# ─── Site identity ─────────────────────────────────────────────────────────────
# Name, URL, and description live in src/config/site.ts.
SITE_URL=https://www.openkauai.org

# ─── Sanity (Open Kauaʻi project only) ─────────────────────────────────────────
# Create or copy the project ID from sanity.io/manage. Do not reuse another client's project.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=          # Viewer (read-only) token. Server-side only.
SANITY_WRITE_TOKEN=        # Editor token. Server-side only. Lets /api/claims/ save "Claim your business" requests. Set it in Vercel too.

# ─── Plan with AI (/plan/) ─────────────────────────────────────────────────────
# Any OpenAI-compatible chat endpoint. Server-side only; set the same values in Vercel.
# Without AI_API_KEY and AI_MODEL the page still works: it builds the day from the directory without the AI.
AI_API_KEY=
AI_MODEL=                  # the model name your provider uses
AI_BASE_URL=               # optional, defaults to https://api.openai.com/v1

# ─── Sanity publish → live (required in production) ────────────────────────────
# Generate: openssl rand -hex 32. Add to Vercel env AND the Sanity webhook header.
ISR_BYPASS_TOKEN=
SANITY_REVALIDATE_SECRET=

# ─── Sanity backup to S3 (optional) ────────────────────────────────────────────
# scripts/sanity-export.ts refuses to run until SITE_FOLDER and SANITY_PROJECT_LOCK match this project.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_SITE=
